<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="outdoor_world">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <!-- Atmosphere / GPS datum -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>12.9716</latitude_deg>
      <longitude_deg>77.5946</longitude_deg>
      <elevation>920</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sky -->
    <sky>
      <time>14</time>
      <clouds>
        <speed>3</speed>
        <humidity>0.5</humidity>
        <mean_size>0.5</mean_size>
        <ambient>0.8 0.8 0.8 1</ambient>
      </clouds>
    </sky>

    <!-- Ground plane (Green grass colour) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ───── Outer boundary fence (40×40 m arena) ───── -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40 0.3 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>40 0.3 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40 0.3 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>40 0.3 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>20 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 40 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 40 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-20 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 40 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 40 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ───── Some trees / obstacles ───── -->
    <model name="tree_1">
      <static>true</static>
      <pose>8 6 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="tree_2">
      <static>true</static>
      <pose>-7 10 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="tree_3">
      <static>true</static>
      <pose>5 -8 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>4</length></cylinder></geometry></collision>
        <visual name="v">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>4</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="tree_4">
      <static>true</static>
      <pose>-12 -5 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>6</length></cylinder></geometry></collision>
        <visual name="v">
          <pose>0 0 3 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>6</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- A concrete block / building -->
    <model name="building_1">
      <static>true</static>
      <pose>-10 8 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 4 5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 4 5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Concrete</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo simulation world and launch files for AMR</description>
  <maintainer email="user@amr.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>gazebo_plugins</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>amr_description</depend>

  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>amr_gui</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
